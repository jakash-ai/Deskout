<Window x:Class="Deskout.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Deskout Settings" 
        Height="540" Width="820"
        WindowStartupLocation="CenterScreen"
        Background="#121214"
        Foreground="White"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Modern ComboBox Styling (Theme-independent) -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#35353A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="true">
                            <!-- Main Background Border -->
                            <Border x:Name="Border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="6"/>
                            
                            <!-- Content presenter for selected value -->
                            <ContentPresenter x:Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="{TemplateBinding Padding}" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left"/>
                            
                            <!-- Vector Arrow -->
                            <Path x:Name="Arrow" 
                                  Data="M 0,0 L 4,4 L 8,0" 
                                  Stroke="White" 
                                  StrokeThickness="1.5" 
                                  HorizontalAlignment="Right" 
                                  VerticalAlignment="Center" 
                                  Margin="0,0,12,0"/>
                            
                            <!-- Popup Dropdown Container -->
                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="true" 
                                   Placement="Bottom" 
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                   Focusable="false" 
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder" 
                                        Background="#1E1E24" 
                                        BorderBrush="#35353A" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        MinWidth="{Binding ActualWidth, ElementName=Border}" 
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer x:Name="DropDownScrollViewer" CanContentScroll="true">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            
                            <!-- Full-Width Invisible Dropdown Toggle ToggleButton -->
                            <ToggleButton Background="Transparent" 
                                          BorderThickness="0" 
                                          ClickMode="Press" 
                                          Focusable="false" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="Height" Value="95"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="BorderBrush" Value="#E53935"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="true">
                                <Setter Property="BorderBrush" Value="#E53935"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#1E1E24"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="true">
                                            <Setter TargetName="Bd" Property="Background" Value="#E53935"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="true">
                                            <Setter TargetName="Bd" Property="Background" Value="#E53935"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Scrollbar Styling -->
        <Style x:Key="ModernScrollViewer" TargetType="{x:Type ScrollViewer}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" 
                                       Value="{TemplateBinding VerticalOffset}" 
                                       Maximum="{TemplateBinding ScrollableHeight}" 
                                       ViewportSize="{TemplateBinding ViewportHeight}" 
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       HorizontalAlignment="Right" 
                                       Width="6"
                                       Margin="0,0,2,0"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Red Accent Button -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#E53935"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#D32F2F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#25252A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#35353A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#323238"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#45454C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Checkbox Styling -->
        <Style x:Key="DayCheckbox" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Border" 
                                Width="20" Height="20" 
                                CornerRadius="4" 
                                Background="#1A1A1E" 
                                BorderBrush="#44444C" 
                                BorderThickness="1.5">
                            <Grid>
                                <TextBlock x:Name="TextSymbol" 
                                           Text="{TemplateBinding Content}" 
                                           Foreground="#8E8E93" 
                                           FontSize="10" 
                                           FontWeight="Bold" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#E53935"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#E53935"/>
                                <Setter TargetName="TextSymbol" Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#E53935"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Setting Switch / Checkbox -->
        <Style x:Key="SettingsSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <BulletDecorator Background="Transparent">
                            <BulletDecorator.Bullet>
                                <Border x:Name="Border" 
                                        Width="16" Height="16" 
                                        CornerRadius="3" 
                                        Background="#1E1E24" 
                                        BorderBrush="#55555F" 
                                        BorderThickness="1.5">
                                    <Grid>
                                        <Path x:Name="CheckMark" 
                                              Data="M 3,8 L 6,11 L 13,3" 
                                              Stroke="#E53935" 
                                              StrokeThickness="2" 
                                              StrokeStartLineCap="Round" 
                                              StrokeEndLineCap="Round"
                                              Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="true">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#E53935"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar -->
            <ColumnDefinition Width="250"/>
            <!-- Main Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0" Background="#16161A" BorderBrush="#252528" BorderThickness="0,0,1.5,0" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Configuration Section -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="DESKOUT CONFIG" FontSize="16" FontWeight="ExtraBold" Foreground="#E53935" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Global Settings" FontSize="12" FontWeight="Bold" Foreground="#8E8E93" Margin="0,0,0,8"/>
                    <CheckBox Content="Force Checklist Completion" IsChecked="{Binding ForceComplete}" Style="{StaticResource SettingsSwitch}"/>
                    <CheckBox Content="Start Automatically with Windows" IsChecked="{Binding StartWithWindows}" Style="{StaticResource SettingsSwitch}"/>
                    <CheckBox Content="Show on System Restart" IsChecked="{Binding ShowOnRestart}" Style="{StaticResource SettingsSwitch}"/>
                    <CheckBox Content="Show on System Sign-out/Logoff" IsChecked="{Binding ShowOnLogoff}" Style="{StaticResource SettingsSwitch}"/>

                    <Border Height="1" Background="#252528" Margin="0,15"/>
                </StackPanel>

                <!-- Git Repositories Section -->
                <Grid Grid.Row="1">
                    <!-- Repos List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource ModernScrollViewer}" Margin="0,0,0,10">
                        <ItemsControl ItemsSource="{Binding GitRepositories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1E1E24" CornerRadius="4" Padding="8,6" Margin="0,4" BorderBrush="#2A2A30" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding}" Foreground="#E0E0E0" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding}"/>
                                            <Button Grid.Column="1" Content="✕" Command="{Binding DataContext.DeleteGitRepoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Foreground="#888" Cursor="Hand" Margin="5,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <!-- Profile Header -->
                <RowDefinition Height="Auto"/>
                <!-- Tasks List View -->
                <RowDefinition Height="*"/>
                <!-- Controls bar -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Profile Selector Header -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Active Profile:" FontSize="13" Foreground="#8E8E93" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                
                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding Profiles}" 
                          SelectedItem="{Binding SelectedProfile}" 
                          DisplayMemberPath="Name"
                          Style="{StaticResource ModernComboBox}"
                          FontSize="13"
                          Width="180" 
                          HorizontalAlignment="Left" 
                          Height="30"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="New Profile" Command="{Binding AddProfileCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
                    <Button Content="Delete Profile" Command="{Binding DeleteProfileCommand}" Style="{StaticResource SecondaryButton}" Foreground="#E53935" BorderBrush="#501A1A"/>
                </StackPanel>
            </Grid>

            <!-- Tasks Table / List -->
            <Grid Grid.Row="1" Margin="0,0,0,15">
                <Border BorderBrush="#252528" BorderThickness="1.5" CornerRadius="8" Background="#16161A">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Headers -->
                            <RowDefinition Height="35"/>
                            <!-- Items -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Headers -->
                        <Border Background="#1E1E24" CornerRadius="7,7,0,0">
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Task Description (Double Click to edit)" Foreground="#8E8E93" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Weekly Schedule (M T W T F S S)" Foreground="#8E8E93" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Delete" Foreground="#8E8E93" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Tasks ScrollList -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{StaticResource ModernScrollViewer}">
                            <ItemsControl ItemsSource="{Binding Tasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#1F1F24" BorderThickness="0,0,0,1" Padding="12,10">
                                            <StackPanel>
                                                <!-- Top Row: Description, Days, Delete -->
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="220"/>
                                                        <ColumnDefinition Width="50"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" 
                                                             Background="Transparent" 
                                                             BorderThickness="0" 
                                                             Foreground="White" 
                                                             FontSize="13" 
                                                             VerticalAlignment="Center"
                                                             CaretBrush="#E53935"/>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <CheckBox Content="M" IsChecked="{Binding IsMonday}" Style="{StaticResource DayCheckbox}" Margin="2,0"/>
                                                        <CheckBox Content="T" IsChecked="{Binding IsTuesday}" Style="{StaticResource DayCheckbox}" Margin="2,0"/>
                                                        <CheckBox Content="W" IsChecked="{Binding IsWednesday}" Style="{StaticResource DayCheckbox}" Margin="2,0"/>
                                                        <CheckBox Content="T" IsChecked="{Binding IsThursday}" Style="{StaticResource DayCheckbox}" Margin="2,0"/>
                                                        <CheckBox Content="F" IsChecked="{Binding IsFriday}" Style="{StaticResource DayCheckbox}" Margin="2,0"/>
                                                        <CheckBox Content="S" IsChecked="{Binding IsSaturday}" Style="{StaticResource DayCheckbox}" Margin="2,0"/>
                                                        <CheckBox Content="S" IsChecked="{Binding IsSunday}" Style="{StaticResource DayCheckbox}" Margin="2,0"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="2" Content="✕" 
                                                            Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                            CommandParameter="{Binding}" 
                                                            Background="Transparent" 
                                                            BorderThickness="0" 
                                                            Foreground="#8E8E93" 
                                                            FontSize="12"
                                                            Cursor="Hand" 
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Bottom Row: Task-specific Reminder Time and Custom URL -->
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/> <!-- Time Label -->
                                                        <ColumnDefinition Width="Auto"/> <!-- Time Dropdowns -->
                                                        <ColumnDefinition Width="Auto"/> <!-- URL Label -->
                                                        <ColumnDefinition Width="*"/>    <!-- URL TextBox -->
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="Reminder Time:" Foreground="#8E8E93" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,15,0" VerticalAlignment="Center">
                                                        <ComboBox ItemsSource="{Binding HourOptions}" 
                                                                  SelectedItem="{Binding SelectedHour}" 
                                                                  Width="45" Height="22" Padding="4,1" FontSize="11"
                                                                  Style="{StaticResource ModernComboBox}"/>
                                                        <TextBlock Text=":" Foreground="#8E8E93" FontSize="11" VerticalAlignment="Center" Margin="2,0"/>
                                                        <ComboBox ItemsSource="{Binding MinuteOptions}" 
                                                                  SelectedItem="{Binding SelectedMinute}" 
                                                                  Width="45" Height="22" Padding="4,1" FontSize="11"
                                                                  Style="{StaticResource ModernComboBox}"/>
                                                        <ComboBox ItemsSource="{Binding AmPmOptions}" 
                                                                  SelectedItem="{Binding SelectedAmPm}" 
                                                                  Width="45" Height="22" Padding="4,1" FontSize="11" Margin="4,0,0,0"
                                                                  Style="{StaticResource ModernComboBox}"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="Task URL:" Foreground="#8E8E93" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBox Grid.Column="3" Text="{Binding CustomUrl, UpdateSourceTrigger=PropertyChanged}" 
                                                             Background="#1E1E24" Foreground="White" BorderBrush="#2A2A30" BorderThickness="1" 
                                                             Padding="4,2" FontSize="11" Height="22" CaretBrush="#E53935"
                                                             ToolTip="Link to Zoho/custom project page"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Controls bar -->
            <Grid Grid.Row="2">
                <Button Content="Add Checklist Task" Command="{Binding AddTaskCommand}" Style="{StaticResource AccentButton}" HorizontalAlignment="Left"/>
                <Button Content="Close Dashboard" Click="CloseBtn_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Height="34" Padding="25,0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
