<Window x:Class="Deskout.Views.CustomInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Input Required" 
        Height="210" Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        Topmost="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Modern Button Styles matching other windows -->
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#E53935"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#D32F2F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#25252A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#35353A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="true">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#323238"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#45454C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#121214" CornerRadius="12" BorderBrush="#252528" BorderThickness="1.5" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Color="#000000" Opacity="0.5" ShadowDepth="2"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title/Prompt -->
                <RowDefinition Height="*"/>    <!-- Input field -->
                <RowDefinition Height="Auto"/> <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Title & Prompt -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock x:Name="TitleTextBlock" Text="DESKOUT" FontSize="14" FontWeight="Bold" Foreground="#E53935" Margin="0,0,0,4"/>
                <TextBlock x:Name="PromptTextBlock" Text="Please enter details:" FontSize="12" Foreground="#8E8E93" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Input Box -->
            <Border Grid.Row="1" CornerRadius="6" Background="#1E1E24" BorderBrush="#35353A" BorderThickness="1" Margin="0,0,0,15" VerticalAlignment="Center">
                <TextBox x:Name="InputTextBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         FontSize="13"
                         Padding="8"
                         CaretBrush="#E53935"
                         KeyDown="InputTextBox_KeyDown"/>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="CancelBtn_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                <Button Content="OK" Click="OkBtn_Click" Style="{StaticResource AccentButton}" Width="80"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
